{
  "name": "tool-dev-smartassistant",
  "display_name": "SmartAssistant",
  "version": "0.1.0",
  "description": "Daily safe spend, nutrition targets and a weekly money and nutrition review.",
  "tools": [
    {
      "name": "ping",
      "description": "Smoke-test method.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "plan_targets",
      "description": "Compute calorie, macro and water targets and the safe daily spend for the rest of the month.",
      "parameters": {
        "type": "object",
        "properties": {
          "weight_kg": {
            "type": "number"
          },
          "height_cm": {
            "type": "number"
          },
          "age": {
            "type": "number"
          },
          "sex": {
            "type": "string",
            "enum": [
              "female",
              "male"
            ]
          },
          "activity": {
            "type": "string",
            "enum": [
              "sedentary",
              "light",
              "moderate",
              "active"
            ]
          },
          "goal": {
            "type": "string",
            "enum": [
              "lose",
              "maintain",
              "gain"
            ]
          },
          "monthly_budget": {
            "type": "number"
          },
          "fixed_costs": {
            "type": "number"
          },
          "spent_so_far": {
            "type": "number"
          },
          "today": {
            "type": "string",
            "description": "YYYY-MM-DD, defaults to today"
          }
        },
        "required": [
          "weight_kg",
          "height_cm",
          "age",
          "monthly_budget"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "weekly_review",
      "description": "Review the 7 days ending on week_end: spending vs allowance, calories, protein and water vs targets, with specific actions.",
      "parameters": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "object"
          },
          "expenses": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "meals": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "water": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "week_end": {
            "type": "string",
            "description": "YYYY-MM-DD, defaults to today"
          }
        },
        "required": [
          "profile"
        ],
        "additionalProperties": false
      }
    }
  ]
}