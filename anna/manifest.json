{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "bundled:smartassistant",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "system_prompt_addendum": "The user has SmartAssistant open. It logs expenses, meals and water, and its weekly review compares the last 7 days with the user's budget and nutrition targets. Do not open extra windows.",
  "tags": ["budget", "nutrition", "weekly-review", "water"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "SmartAssistant",
        "default": true,
        "default_size": { "w": 480, "h": 720 },
        "min_size": { "w": 320, "h": 480 }
      }
    ],
    "host_api": {
      "tools": ["required:bundled:smartassistant"],
      "storage": ["get", "set"],
      "llm": ["complete"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
