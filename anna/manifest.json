{
  "schema": 2,
  "required_executas": [
    {
      "tool_id": "bundled:smartassistant",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "system_prompt_addendum": "SmartAssistant tracks personal budget runway, daily safe spend, nutrition macros, intermittent fasting, and weekly reviews. When the user asks to open SmartAssistant, view their dashboard, log expenses or meals, or start their review, summon the app window via open_app_view with this app's numeric app_id.",
  "tags": ["budget", "nutrition", "weekly-review", "water"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "SmartAssistant",
        "default": true,
        "single_instance": true,
        "default_size": { "w": 480, "h": 720 },
        "min_size": { "w": 320, "h": 480 }
      }
    ],
    "host_api": {
      "tools": ["required:bundled:smartassistant"],
      "storage": ["get", "set"],
      "llm": ["complete"],
      "window": ["set_title", "ready"]
    },
    "csp_overrides": {},
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
